{
  "name": "@jii/prisma",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/@jii/prisma/src",
  "projectType": "library",
  "tags": ["scope:server"],
  "targets": {
    "cloudsql-proxy": {
      "metadata": {
        "description": "Runs the CloudSQL proxy used to develop against the staging DB, keeping gcloud ADC credentials fresh (refreshing and restarting the container as needed) for the whole session."
      },
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsx scripts/cloudSqlProxy.mts"
      }
    },
    "local-dbs": {
      "metadata": {
        "description": "Starts the local Postgres containers (dev + test) used when not developing against the staging DB."
      },
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {
          "command": "docker compose up --wait db test-db"
        },
        "test": {
          "command": "echo 'No docker for CI'"
        }
      },
      "defaultConfiguration": "dev"
    },

    "docker-down": {
      "executor": "nx:run-commands",
      "options": { "cwd": "{projectRoot}" },
      "configurations": {
        "dev": {
          "command": "docker compose down"
        },
        "test": {
          "command": "echo 'No docker for CI'"
        }
      },
      "defaultConfiguration": "dev"
    },
    "init-db": {
      "metadata": {
        "description": "Ensures that a DB exists for each state configured in the environment"
      },
      "executor": "nx:run-commands",
      "dependsOn": ["local-dbs"],
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {
          "command": "tsx scripts/initDbs.mts"
        },
        "test": {
          "command": "echo 'No docker for CI'"
        },
        "e2e": {
          "command": "tsx scripts/initDbs.mts"
        }
      },
      "defaultConfiguration": "dev"
    },
    "prepare-test-db": {
      "metadata": {
        "description": "Resets the DB for unit tests, which only use the default postgres DB. Requires a DATABASE_URL to be specified in the env."
      },
      "dependsOn": ["init-db"],
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate reset --force",
        "cwd": "{projectRoot}"
      }
    },
    "prepare-e2e-db": {
      "metadata": {
        "description": "Resets and seeds state DBs in docker for e2e tests."
      },
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "nx prisma-reset @jii/prisma -c e2e --force",
          "nx seed @jii/import -c e2e"
        ],
        "parallel": false
      },
      "configurations": {
        "ci": {
          "commands": ["echo 'skipping in CI'"]
        }
      }
    },
    "prisma-deploy": {
      "metadata": {
        "description": "Runs migrations (prisma migrate deploy) in each state DB."
      },
      "dependsOn": ["init-db"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {
          "command": "tsx scripts/runForAllStates.mts --prisma-cmd=\"migrate deploy\""
        },
        "test": {
          "command": "prisma migrate dev"
        }
      },
      "defaultConfiguration": "dev"
    },
    "prisma-format": {
      "executor": "@nx-tools/nx-prisma:format",
      "options": {
        "schema": "{projectRoot}/prisma/schema.prisma"
      }
    },
    "prisma-generate": {
      "inputs": ["{projectRoot}/prisma/schema.prisma"],
      "executor": "@nx-tools/nx-prisma:generate",
      "options": {
        "schema": "{projectRoot}/prisma/schema.prisma"
      }
    },
    "prisma-migrate": {
      "metadata": {
        "description": "Verifies migrations for all state DBs (prisma migrate dev). Requires a --name argument if a new migration is needed."
      },
      "dependsOn": ["init-db"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {
          "command": "tsx scripts/runForAllStates.mts --prisma-cmd=\"migrate dev\""
        },
        "test": {
          "command": "prisma migrate dev"
        }
      },
      "defaultConfiguration": "dev"
    },
    "prisma-pull": {
      "metadata": {
        "description": "Pulls changes from the DB into the Prisma schema. Requires a DATABASE_URL to be specified in the env."
      },
      "executor": "@nx-tools/nx-prisma:pull",
      "options": {
        "schema": "{projectRoot}/prisma/schema.prisma"
      }
    },
    "prisma-push": {
      "metadata": {
        "description": "Pushes latest schema changes to all state DBs without generating a migration"
      },
      "dependsOn": ["init-db"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {
          "command": "tsx scripts/runForAllStates.mts --prisma-cmd=\"db push\""
        },
        "test": {
          "command": "prisma migrate dev"
        }
      },
      "defaultConfiguration": "dev"
    },
    "prisma-reset": {
      "metadata": {
        "description": "Wipes all state DBs and reruns migrations (prisma migrate reset). Requires a --force argument"
      },
      "dependsOn": ["init-db"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {
          "command": "tsx scripts/runForAllStates.mts --prisma-cmd=\"migrate reset\""
        },
        "e2e": {
          "command": "tsx scripts/runForAllStates.mts --prisma-cmd=\"migrate reset\""
        },
        "test": {
          "command": "prisma migrate dev"
        }
      },
      "defaultConfiguration": "dev"
    },
    "prisma-resolve": {
      "metadata": {
        "description": "Lets you mark failed migrations as applied or rolled back. Requires a DATABASE_URL to be specified in the env."
      },
      "executor": "@nx-tools/nx-prisma:resolve",
      "options": {
        "schema": "{projectRoot}/prisma/schema.prisma"
      }
    },
    "prisma-status": {
      "metadata": {
        "description": "Reports on the state of migrations in the DB. Requires a DATABASE_URL to be specified in the env."
      },
      "executor": "@nx-tools/nx-prisma:status",
      "options": {
        "schema": "{projectRoot}/prisma/schema.prisma"
      }
    },
    "prisma-studio": {
      "metadata": {
        "description": "Runs prisma studio for a single state DB (-s or --state-code)"
      },
      "dependsOn": [{ "target": "init-db", "params": "ignore" }],
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/studioDev.mts",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "e2e": {}
      }
    },
    "prisma-validate": {
      "executor": "@nx-tools/nx-prisma:validate",
      "options": {
        "schema": "{projectRoot}/prisma/schema.prisma"
      }
    },
    "requires-sops-env:test": {
      "dependsOn": ["prisma-generate"],
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/libs/@jii/prisma"],
      "cache": true,
      "options": {
        "command": "vitest",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate"],
      "options": {
        "commands": [
          "tsc -p ./tsconfig.lib.json",
          "tsc -p ./tsconfig.spec.json"
        ],
        "cwd": "{projectRoot}"
      }
    }
  }
}
