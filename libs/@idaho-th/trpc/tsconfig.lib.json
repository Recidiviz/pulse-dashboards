{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pure typecheck: consumers import this lib's src source, not emitted output, so we
    // don't emit. Declaration emit is off because tsc (TypeScript 7) runs declaration diagnostics that
    // trip on the generated Prisma client we import (TS4094 on #private fields) —
    // unwinnable third-party generated code.
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "vite.config.mts",
    "src/setupTests.ts",
    "src/setupTestsGlobal.ts"
  ]
}
