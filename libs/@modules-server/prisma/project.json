{
  "name": "@modules-server/prisma",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/@modules-server/prisma/src",
  "projectType": "library",
  "tags": ["scope:server"],
  "metadata": {
    "sops-env": {
      "override-sops-env-project": "@modules/server"
    }
  },
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate"],
      "options": {
        "commands": [
          "tsc -p ./tsconfig.lib.json",
          "tsc -p ./tsconfig.spec.json"
        ],
        "cwd": "{projectRoot}"
      }
    },
    "local-dbs": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {
          "command": "docker compose up --wait"
        },
        "ci": { "command": "echo 'No docker for CI'" },
        "test": { "command": "echo 'No docker for CI'" }
      },
      "defaultConfiguration": "dev"
    },
    "prisma-generate": {
      "inputs": ["{projectRoot}/prisma/**/*"],
      "executor": "@nx-tools/nx-prisma:generate",
      "options": {
        "schema": "{projectRoot}/prisma"
      },
      "configurations": {
        "dev": {},
        "test": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:prisma-format": {
      "executor": "@nx-tools/nx-prisma:format",
      "options": {
        "schema": "{projectRoot}/prisma"
      },
      "configurations": {
        "dev": {},
        "test": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:prisma-migrate": {
      "dependsOn": ["local-dbs"],
      "executor": "@nx-tools/nx-prisma:migrate",
      "options": {
        "schema": "{projectRoot}/prisma"
      },
      "configurations": {
        "dev": {},
        "test": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:prisma-pull": {
      "executor": "@nx-tools/nx-prisma:pull",
      "options": {
        "schema": "{projectRoot}/prisma"
      },
      "configurations": {
        "dev": {},
        "test": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:prisma-push": {
      "executor": "@nx-tools/nx-prisma:push",
      "dependsOn": ["local-dbs"],
      "options": {
        "schema": "{projectRoot}/prisma"
      },
      "configurations": {
        "dev": {},
        "test": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:prisma-studio": {
      "executor": "@nx-tools/nx-prisma:studio",
      "options": {
        "schema": "{projectRoot}/prisma"
      },
      "configurations": {
        "dev": {},
        "test": {}
      },
      "defaultConfiguration": "dev"
    },
    "test": {
      "dependsOn": ["prisma-generate"]
    }
  }
}
