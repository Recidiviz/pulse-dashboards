{
  "name": "@modules/Calendar/prisma",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/@modules/Calendar/prisma/src",
  "projectType": "library",
  "tags": ["scope:server"],
  "metadata": {
    "sops-env": {
      "override-sops-env-project": "@modules/server"
    }
  },
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p ./tsconfig.lib.json",
          "tsc -p ./tsconfig.spec.json"
        ],
        "cwd": "{projectRoot}"
      }
    },
    "local-dbs": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {
          "command": "docker compose up --wait"
        },
        "ci": { "command": "echo 'No docker for CI'" },
        "test": { "command": "echo 'No docker for CI'" }
      },
      "defaultConfiguration": "dev"
    },
    "prisma-generate": {
      "inputs": ["{projectRoot}/prisma/**/*", "{projectRoot}/prisma.config.ts"],
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma generate",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {},
        "test": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:prisma-format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma format",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {},
        "test": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:prisma-migrate": {
      "dependsOn": ["local-dbs"],
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate dev",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {},
        "test": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:prisma-pull": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma db pull",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {},
        "test": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:prisma-push": {
      "executor": "nx:run-commands",
      "dependsOn": ["local-dbs"],
      "options": {
        "command": "prisma db push",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {},
        "test": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:prisma-reset": {
      "executor": "nx:run-commands",
      "dependsOn": ["local-dbs"],
      "options": {
        "command": "prisma migrate reset",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {},
        "test": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:prisma-studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma studio",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {},
        "test": {}
      },
      "defaultConfiguration": "dev"
    }
  }
}
