{
  "name": "@meetings/app",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/@meetings/app/src",
  "projectType": "application",
  "tags": ["meetings", "type:app"],
  "// targets": "to see all targets run: nx show project @meetings/app --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p ./tsconfig.app.json",
          "tsc -p ./tsconfig.spec.json"
        ],
        "cwd": "{projectRoot}"
      }
    },
    "requires-sops-env:test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest",
        "cwd": "{projectRoot}"
      }
    },
    "requires-sops-env:sync-env-to-eas": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/sync-env-to-eas.mts",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": { "args": "development" },
        "staging": { "args": "staging" },
        "production": { "args": "production" }
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:dev:android": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "EXPO_NO_GIT_STATUS=1 nx prebuild @meetings/app --clean",
            "forwardAllArgs": false
          },
          "nx run-android @meetings/app --no-build-cache"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {},
        "staging": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:dev:android:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "expo run:android",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {},
        "staging": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:dev:android:auto": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "scripts/android-wireless-connect.sh || true",
            "forwardAllArgs": false
          },
          "EXPO_PUBLIC_SERVER_URL=\"http://$(scripts/get-lan-ip.sh):${PORT:-3002}/\" REACT_NATIVE_PACKAGER_HOSTNAME=\"$(scripts/get-lan-ip.sh)\" expo run:android --device"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {},
        "staging": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:dev:ios": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean",
            "forwardAllArgs": false
          },
          "expo run:ios --no-build-cache"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {},
        "staging": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:dev:ios:fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "expo run:ios",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {},
        "staging": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:dev:ios:auto": {
      "executor": "nx:run-commands",
      "options": {
        "command": "EXPO_PUBLIC_SERVER_URL=\"http://$(scripts/get-lan-ip.sh):${PORT:-3002}/\" REACT_NATIVE_PACKAGER_HOSTNAME=\"$(scripts/get-lan-ip.sh)\" expo run:ios --device",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {},
        "staging": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:web": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["nx start @meetings/app --web"]
      },
      "cwd": "{workspaceRoot}",
      "configurations": {
        "dev": {},
        "staging": {}
      },
      "defaultConfiguration": "dev"
    },
    "requires-sops-env:build:web": {
      "command": "EXPO_PUBLIC_SENTRY_RELEASE=${EXPO_PUBLIC_SENTRY_RELEASE:-$(git rev-parse --short=12 HEAD)} nx export @meetings/app -p web --source-maps --skip-nx-cache",
      "cache": false,
      "configurations": {
        "dev": {},
        "staging": { "env": { "APP_ENV": "staging" } },
        "production": { "env": { "APP_ENV": "production" } }
      }
    },
    "requires-sops-env:upload-sourcemaps:web": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build:web",
          "params": "forward"
        }
      ],
      "options": {
        "command": "find dist -name \"*.map\" | grep -q . && yarn sentry-expo-upload-sourcemaps dist",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "staging": {},
        "production": {}
      },
      "defaultConfiguration": "staging"
    },
    "steiger": {
      "executor": "nx:run-commands",
      "options": {
        "command": "steiger ./src",
        "cwd": "{projectRoot}"
      }
    },
    "requires-sops-env:deploy:web": {
      "dependsOn": [{ "target": "upload-sourcemaps:web", "params": "forward" }],
      "command": "firebase deploy --config firebase.meetings.json",
      "configurations": {
        "staging": {
          "args": "--project meetings-staging --only hosting"
        },
        "production": {
          "args": "--project meetings-production --only hosting"
        }
      },
      "defaultConfiguration": "staging"
    }
  }
}
