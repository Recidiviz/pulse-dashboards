{
  "name": "@modules/server",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/@modules/server/src",
  "projectType": "application",
  "tags": ["scope:server"],
  "targets": {
    "requires-sops-env:dev": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "dev",
      "dependsOn": ["build", "^local-dbs"],
      "options": {
        "buildTarget": "@modules/server:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "dev": {
          "buildTarget": "@modules/server:build:dev"
        }
      }
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "{workspaceRoot}/dist/apps/@modules/server",
        "bundle": true,
        "main": "{projectRoot}/src/main.ts",
        "tsConfig": "{projectRoot}/tsconfig.app.json",
        "assets": ["{projectRoot}/src/assets", "{workspaceRoot}/.yarnrc.yml"],
        "generatePackageJson": true,
        "minify": true,
        "target": "node22",
        "external": ["@prisma/client"],
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "dev": {
          "minify": false
        },
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            }
          }
        }
      }
    },
    "requires-sops-env:test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["@modules-server/prisma"],
          "target": "prisma-generate"
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/apps/modules"],
      "cache": true,
      "options": {
        "command": "cd apps/@modules/server && vitest run",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "test": {}
      },
      "defaultConfiguration": "test"
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/@modules/server/package.json",
        "{workspaceRoot}/dist/apps/@modules/server/yarn.lock"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/@modules/server/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": ["build"],
      "cwd": "{projectRoot}",
      "options": {
        "engine": "docker",
        "platforms": ["linux/amd64"]
      },
      "configurations": {
        "dev": {
          "push": false
        },
        "staging": {
          "push": true,
          "tags": [
            "us-central1-docker.pkg.dev/recidiviz-dashboard-staging/product-modules/product-modules-server:$COMMIT_SHA",
            "us-central1-docker.pkg.dev/recidiviz-dashboard-staging/product-modules/product-modules-server:latest"
          ]
        },
        "cherry-pick": {
          "push": true,
          "tags": [
            "us-central1-docker.pkg.dev/recidiviz-dashboard-staging/product-modules/product-modules-server:$COMMIT_SHA"
          ]
        },
        "preview": {
          "push": true,
          "tags": [
            "us-central1-docker.pkg.dev/recidiviz-dashboard-staging/product-modules/product-modules-server-preview:$VERSION"
          ]
        }
      },
      "defaultConfiguration": "dev"
    }
  }
}
