{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts"
    ]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/*.ts",
    "src/**/__tests__/*.tsx",
    "src/**/*.d.ts",
    "vite.config.mts",
    "src/setupTests.ts",
    "src/setupTestsGlobal.ts"
  ]
}
