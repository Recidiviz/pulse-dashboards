{
  "name": "@idaho-th/client",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/@idaho-th/client/src",
  "projectType": "application",
  "tags": ["idaho-th", "scope:client"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc -p ./tsconfig.app.json"],
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite dev",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "cache": true,
      "options": {
        "outputPath": "{workspaceRoot}/dist/apps/@idaho-th/client",
        "emptyOutDir": true
      },
      "configurations": {
        "staging": {
          "mode": "staging"
        },
        "production": {
          "mode": "production"
        }
      },
      "defaultConfiguration": "staging"
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --outDir ../../../dist/apps/@idaho-th/client",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "staging": {},
        "production": {}
      },
      "defaultConfiguration": "staging",
      "dependsOn": [{ "target": "build", "params": "forward" }]
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/@idaho-th/client"],
      "cache": true,
      "options": {
        "command": "vitest",
        "cwd": "{projectRoot}"
      }
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": [{ "target": "build", "params": "forward" }],
      "options": {
        "engine": "docker",
        "platforms": ["linux/amd64"],
        "context": "{workspaceRoot}",
        "file": "apps/@idaho-th/client/Dockerfile"
      },
      "configurations": {
        "dev": {
          "push": false
        },
        "staging": {
          "push": true,
          "tags": [
            "us-central1-docker.pkg.dev/rcdvz-transitional-housing-dev/idaho-th/idaho-th-client:$COMMIT_SHA",
            "us-central1-docker.pkg.dev/rcdvz-transitional-housing-dev/idaho-th/idaho-th-client:latest"
          ]
        },
        "cherry-pick": {
          "push": true,
          "tags": [
            "us-central1-docker.pkg.dev/rcdvz-transitional-housing-dev/idaho-th/idaho-th-client:$COMMIT_SHA"
          ]
        }
      },
      "defaultConfiguration": "dev"
    }
  }
}
